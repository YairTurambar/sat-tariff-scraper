SAT_BASE_URL=https://portal.sat.gob.gt/portal/arancel-integrado/
SAT_BROWSER_TYPE=chromium
# Optional Playwright channel: chrome, msedge, chrome-beta, msedge-beta, ...
SAT_BROWSER_CHANNEL=
# Optional explicit browser executable, for example:
# C:\Program Files\Google\Chrome\Application\chrome.exe
SAT_BROWSER_EXECUTABLE_PATH=
# Auto-detect an installed Chrome/Edge/Chromium when Playwright has no managed browser
SAT_BROWSER_FALLBACK_TO_SYSTEM=true
# Extra executables to try first, separated by the OS path separator or by commas
SAT_BROWSER_CANDIDATE_PATHS=
SAT_HEADLESS=false
SAT_PROFILE_DIR=playwright-user-data
SAT_NAVIGATION_TIMEOUT_MS=30000
SAT_ACTION_TIMEOUT_MS=10000
SAT_MAX_RETRIES=2
SAT_RETRY_BACKOFF_FACTOR=2.0
SAT_DELAY_BETWEEN_CODES_SECONDS=1.0
SAT_INPUT_FILE=HS_codes.txt
SAT_SQLITE_DB=sat_tariff.db
SAT_OUTPUT_XLSX=sat_tariff_example.xlsx
SAT_ARTIFACTS_DIR=artifacts
SAT_LOGS_DIR=logs
SAT_LOG_LEVEL=INFO
SAT_OVERWRITE_OUTPUT=true
SAT_BACKUP_OUTPUT=true
SAT_INVALID_LINE_POLICY=skip
SAT_ARTIFACT_RETENTION_COUNT=20
